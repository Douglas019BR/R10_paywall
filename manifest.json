{
  "manifest_version": 3,
  "name": "R10 Paywall",
  "version": "0.1.0",
  "description": "Read paywalled articles by fetching the raw HTML and stripping the client-side paywall.",
  "permissions": ["activeTab", "scripting", "declarativeNetRequestWithHostAccess", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "R10 Paywall"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
